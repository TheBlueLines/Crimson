<Page
	x:Class="Crimson.Views.StorePage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:converters="using:CommunityToolkit.WinUI.Converters"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:utils="using:Crimson.Utils"
	xmlns:viewModels="using:Crimson.ViewModels"
	mc:Ignorable="d">

	<Page.Resources>
		<converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
		<utils:DecodedImageUrlConverter x:Key="DecodedImageUrlConverter" />

		<!--  Same scrim as the Library cards, so store and library covers read alike.  -->
		<LinearGradientBrush x:Key="CardScrimBrush" StartPoint="0,0" EndPoint="0,1">
			<GradientStop Offset="0.45" Color="Transparent" />
			<GradientStop Offset="1" Color="#BF000000" />
		</LinearGradientBrush>

		<DataTemplate x:Key="StoreCardTemplate" x:DataType="viewModels:StoreItem">
			<Button
				Width="216"
				Padding="0"
				HorizontalAlignment="Stretch"
				VerticalAlignment="Top"
				HorizontalContentAlignment="Stretch"
				VerticalContentAlignment="Top"
				Background="Transparent"
				BorderThickness="0"
				Click="StoreItem_Click"
				DataContext="{x:Bind}"
				ToolTipService.ToolTip="{x:Bind Title}">
				<Button.Resources>
					<CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
					<CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>
				</Button.Resources>
				<StackPanel Spacing="8">
					<Grid
						Height="290"
						Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
						CornerRadius="8">
						<Image Source="{x:Bind ImageUrl, Converter={StaticResource DecodedImageUrlConverter}, ConverterParameter=216}" Stretch="UniformToFill" />
						<Border
							Height="92"
							VerticalAlignment="Bottom"
							Background="{StaticResource CardScrimBrush}" />
						<TextBlock
							Margin="12,0,12,10"
							VerticalAlignment="Bottom"
							FontSize="14"
							FontWeight="SemiBold"
							Foreground="White"
							MaxLines="2"
							Text="{x:Bind Title}"
							TextTrimming="CharacterEllipsis"
							TextWrapping="WrapWholeWords" />
						<Border
							Margin="8"
							Padding="8,3"
							HorizontalAlignment="Left"
							VerticalAlignment="Top"
							Background="{ThemeResource AccentFillColorDefaultBrush}"
							CornerRadius="4"
							Visibility="{x:Bind IsOwned, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
							<TextBlock
								FontSize="12"
								FontWeight="SemiBold"
								Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
								Text="{x:Bind OwnershipText, Mode=OneWay}" />
						</Border>
					</Grid>
					<StackPanel
						Margin="2,0"
						Orientation="Horizontal"
						Spacing="8"
						Visibility="{x:Bind ShowPrice, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
						<Border
							Padding="6,1"
							VerticalAlignment="Center"
							Background="{ThemeResource AccentFillColorDefaultBrush}"
							CornerRadius="4"
							Visibility="{x:Bind HasDiscount, Converter={StaticResource BoolToVisibilityConverter}}">
							<TextBlock
								FontSize="12"
								FontWeight="SemiBold"
								Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
								Text="{x:Bind DiscountText}" />
						</Border>
						<TextBlock
							VerticalAlignment="Center"
							Foreground="{ThemeResource TextFillColorSecondaryBrush}"
							Text="{x:Bind OriginalPriceText}"
							TextDecorations="Strikethrough"
							Visibility="{x:Bind HasOriginalPrice, Converter={StaticResource BoolToVisibilityConverter}}" />
						<TextBlock
							VerticalAlignment="Center"
							Style="{StaticResource BodyStrongTextBlockStyle}"
							Text="{x:Bind PriceText}" />
					</StackPanel>
					<TextBlock
						Margin="2,0"
						Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
						Style="{StaticResource CaptionTextBlockStyle}"
						Text="{x:Bind Caption}"
						Visibility="{x:Bind HasCaption, Converter={StaticResource BoolToVisibilityConverter}}" />
				</StackPanel>
			</Button>
		</DataTemplate>
	</Page.Resources>

	<Grid>
		<ScrollViewer
			Padding="36,24,36,36"
			HorizontalScrollBarVisibility="Disabled"
			VerticalScrollBarVisibility="Auto">
			<StackPanel Spacing="24">
				<Grid ColumnSpacing="16">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>
					<StackPanel Spacing="4">
						<TextBlock Style="{StaticResource TitleLargeTextBlockStyle}" Text="Store" />
						<TextBlock
							Foreground="{ThemeResource TextFillColorSecondaryBrush}"
							Style="{StaticResource BodyTextBlockStyle}"
							Text="Browse and search the Epic Games Store" />
					</StackPanel>
					<StackPanel
						Grid.Column="1"
						VerticalAlignment="Bottom"
						Orientation="Horizontal"
						Spacing="8">
						<AutoSuggestBox
							x:Name="StoreSearchBox"
							Width="280"
							PlaceholderText="Search the store"
							QueryIcon="Find"
							QuerySubmitted="StoreSearchBox_QuerySubmitted"
							Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}" />
						<Button Click="RedeemButton_Click" ToolTipService.ToolTip="Redeem a product code on the Epic Games Store">
							<StackPanel Orientation="Horizontal" Spacing="8">
								<FontIcon FontSize="14" Glyph="&#xE8C7;" />
								<TextBlock Text="Redeem code" />
							</StackPanel>
						</Button>
					</StackPanel>
				</Grid>

				<!--  Store front: free games, new releases and sales.  -->
				<StackPanel Spacing="28" Visibility="{x:Bind ViewModel.IsDiscoverVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
					<StackPanel Spacing="12" Visibility="{x:Bind ViewModel.HasFreeGames, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
						<TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Free games" />
						<ScrollViewer
							HorizontalScrollBarVisibility="Auto"
							HorizontalScrollMode="Enabled"
							VerticalScrollBarVisibility="Disabled"
							VerticalScrollMode="Disabled">
							<ItemsRepeater
								Margin="0,0,0,12"
								ItemTemplate="{StaticResource StoreCardTemplate}"
								ItemsSource="{x:Bind ViewModel.FreeGames, Mode=OneWay}">
								<ItemsRepeater.Layout>
									<StackLayout Orientation="Horizontal" Spacing="12" />
								</ItemsRepeater.Layout>
							</ItemsRepeater>
						</ScrollViewer>
					</StackPanel>

					<StackPanel Spacing="12" Visibility="{x:Bind ViewModel.HasNewReleases, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
						<Grid>
							<TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="New releases" />
							<HyperlinkButton
								HorizontalAlignment="Right"
								Command="{x:Bind ViewModel.ShowNewReleasesCommand}"
								Content="See all" />
						</Grid>
						<ScrollViewer
							HorizontalScrollBarVisibility="Auto"
							HorizontalScrollMode="Enabled"
							VerticalScrollBarVisibility="Disabled"
							VerticalScrollMode="Disabled">
							<ItemsRepeater
								Margin="0,0,0,12"
								ItemTemplate="{StaticResource StoreCardTemplate}"
								ItemsSource="{x:Bind ViewModel.NewReleases, Mode=OneWay}">
								<ItemsRepeater.Layout>
									<StackLayout Orientation="Horizontal" Spacing="12" />
								</ItemsRepeater.Layout>
							</ItemsRepeater>
						</ScrollViewer>
					</StackPanel>

					<StackPanel Spacing="12" Visibility="{x:Bind ViewModel.HasOnSale, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
						<Grid>
							<TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="On sale" />
							<HyperlinkButton
								HorizontalAlignment="Right"
								Command="{x:Bind ViewModel.ShowOnSaleCommand}"
								Content="See all" />
						</Grid>
						<ScrollViewer
							HorizontalScrollBarVisibility="Auto"
							HorizontalScrollMode="Enabled"
							VerticalScrollBarVisibility="Disabled"
							VerticalScrollMode="Disabled">
							<ItemsRepeater
								Margin="0,0,0,12"
								ItemTemplate="{StaticResource StoreCardTemplate}"
								ItemsSource="{x:Bind ViewModel.OnSale, Mode=OneWay}">
								<ItemsRepeater.Layout>
									<StackLayout Orientation="Horizontal" Spacing="12" />
								</ItemsRepeater.Layout>
							</ItemsRepeater>
						</ScrollViewer>
					</StackPanel>
				</StackPanel>

				<!--  Search results and "see all" lists.  -->
				<StackPanel Spacing="16" Visibility="{x:Bind ViewModel.IsResultsVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
					<Grid ColumnSpacing="12">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<Button
							VerticalAlignment="Center"
							Command="{x:Bind ViewModel.ShowDiscoverCommand}"
							ToolTipService.ToolTip="Back to the store front">
							<FontIcon FontSize="14" Glyph="&#xE72B;" />
						</Button>
						<StackPanel
							Grid.Column="1"
							VerticalAlignment="Center"
							Spacing="2">
							<TextBlock
								Style="{StaticResource SubtitleTextBlockStyle}"
								Text="{x:Bind ViewModel.ResultsTitle, Mode=OneWay}"
								TextTrimming="CharacterEllipsis" />
							<TextBlock
								Foreground="{ThemeResource TextFillColorSecondaryBrush}"
								Style="{StaticResource CaptionTextBlockStyle}"
								Text="{x:Bind ViewModel.ResultsSummary, Mode=OneWay}" />
						</StackPanel>
						<ComboBox
							Grid.Column="2"
							MinWidth="200"
							VerticalAlignment="Center"
							Header="Sort by"
							ItemsSource="{x:Bind ViewModel.SortOptions}"
							SelectedIndex="{x:Bind ViewModel.SelectedSortIndex, Mode=TwoWay}">
							<ComboBox.ItemTemplate>
								<DataTemplate x:DataType="viewModels:StoreSortOption">
									<TextBlock Text="{x:Bind Name}" />
								</DataTemplate>
							</ComboBox.ItemTemplate>
						</ComboBox>
					</Grid>

					<ItemsRepeater ItemTemplate="{StaticResource StoreCardTemplate}" ItemsSource="{x:Bind ViewModel.Results}">
						<ItemsRepeater.Layout>
							<UniformGridLayout
								MinColumnSpacing="12"
								MinRowSpacing="16"
								Orientation="Horizontal" />
						</ItemsRepeater.Layout>
					</ItemsRepeater>

					<Button
						HorizontalAlignment="Center"
						Command="{x:Bind ViewModel.LoadMoreCommand}"
						Visibility="{x:Bind ViewModel.CanLoadMore, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
						<StackPanel Orientation="Horizontal" Spacing="10">
							<ProgressRing
								Width="16"
								Height="16"
								IsActive="{x:Bind ViewModel.IsLoadingMore, Mode=OneWay}" />
							<TextBlock Text="Show more" />
						</StackPanel>
					</Button>
				</StackPanel>

				<StackPanel
					Margin="0,48,0,0"
					HorizontalAlignment="Center"
					Spacing="12"
					Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
					<ProgressRing
						Width="48"
						Height="48"
						HorizontalAlignment="Center"
						IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
					<TextBlock
						HorizontalAlignment="Center"
						Foreground="{ThemeResource TextFillColorSecondaryBrush}"
						Style="{StaticResource BodyTextBlockStyle}"
						Text="Loading the store..." />
				</StackPanel>

				<StackPanel
					Margin="0,48,0,0"
					HorizontalAlignment="Center"
					Spacing="8"
					Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
					<FontIcon
						HorizontalAlignment="Center"
						FontSize="48"
						Foreground="{ThemeResource TextFillColorTertiaryBrush}"
						Glyph="&#xE721;" />
					<TextBlock
						HorizontalAlignment="Center"
						Style="{StaticResource SubtitleTextBlockStyle}"
						Text="Nothing found" />
					<TextBlock
						HorizontalAlignment="Center"
						Foreground="{ThemeResource TextFillColorSecondaryBrush}"
						Style="{StaticResource BodyTextBlockStyle}"
						Text="Try a different search." />
				</StackPanel>

				<StackPanel
					MaxWidth="520"
					Margin="0,48,0,0"
					HorizontalAlignment="Center"
					Spacing="12"
					Visibility="{x:Bind ViewModel.ShowError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
					<TextBlock
						HorizontalAlignment="Center"
						Style="{ThemeResource SubtitleTextBlockStyle}"
						Text="The store could not be loaded" />
					<TextBlock
						HorizontalAlignment="Center"
						Foreground="{ThemeResource TextFillColorSecondaryBrush}"
						Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
						TextAlignment="Center"
						TextWrapping="Wrap" />
					<Button
						HorizontalAlignment="Center"
						Command="{x:Bind ViewModel.RetryCommand}"
						Content="Try again" />
				</StackPanel>
			</StackPanel>
		</ScrollViewer>
	</Grid>
</Page>
