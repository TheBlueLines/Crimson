<Page
	x:Class="Crimson.Views.StoreProductPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="using:Crimson.Controls"
	xmlns:converters="using:CommunityToolkit.WinUI.Converters"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:utils="using:Crimson.Utils"
	mc:Ignorable="d">

	<Page.Resources>
		<converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
		<utils:DecodedImageUrlConverter x:Key="DecodedImageUrlConverter" />
		<utils:StoreProductActionGlyphConverter x:Key="StoreProductActionGlyphConverter" />

		<!--  Matches the GameInfoPage hero so store and library pages feel like one app.  -->
		<LinearGradientBrush x:Key="HeroScrimBrush" StartPoint="0,0" EndPoint="0,1">
			<GradientStop Offset="0" Color="#33000000" />
			<GradientStop Offset="0.5" Color="Transparent" />
			<GradientStop Offset="1" Color="#CC000000" />
		</LinearGradientBrush>
	</Page.Resources>

	<Grid x:Name="RootGrid">
		<VisualStateManager.VisualStateGroups>
			<VisualStateGroup>
				<VisualState x:Name="Wide">
					<VisualState.StateTriggers>
						<AdaptiveTrigger MinWindowWidth="1100" />
					</VisualState.StateTriggers>
					<VisualState.Setters>
						<Setter Target="HeroSection.Height" Value="340" />
						<Setter Target="SideColumn.Width" Value="320" />
						<Setter Target="SidePanel.(Grid.Column)" Value="1" />
						<Setter Target="SidePanel.(Grid.Row)" Value="0" />
						<Setter Target="SidePanel.(Grid.RowSpan)" Value="2" />
						<Setter Target="MainPanel.(Grid.Row)" Value="0" />
						<Setter Target="MainPanel.(Grid.RowSpan)" Value="2" />
					</VisualState.Setters>
				</VisualState>
				<VisualState x:Name="Narrow" />
			</VisualStateGroup>
		</VisualStateManager.VisualStateGroups>

		<ScrollViewer
			HorizontalScrollBarVisibility="Disabled"
			VerticalScrollBarVisibility="Auto"
			Visibility="{x:Bind ViewModel.IsContentVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
			<StackPanel>
				<Grid
					x:Name="HeroSection"
					Height="260"
					Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
					<Image Source="{x:Bind ViewModel.HeroImageUrl, Mode=OneWay, Converter={StaticResource DecodedImageUrlConverter}, ConverterParameter=1920}" Stretch="UniformToFill" />
					<Border Background="{StaticResource HeroScrimBrush}" />
					<TextBlock
						MaxWidth="900"
						Margin="36,0,36,24"
						HorizontalAlignment="Left"
						VerticalAlignment="Bottom"
						FontWeight="SemiBold"
						Foreground="White"
						Style="{StaticResource TitleLargeTextBlockStyle}"
						Text="{x:Bind ViewModel.Title, Mode=OneWay}"
						TextTrimming="CharacterEllipsis"
						TextWrapping="Wrap" />
				</Grid>

				<Grid
					Padding="36,24,36,36"
					ColumnSpacing="36"
					RowSpacing="24">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition x:Name="SideColumn" Width="0" />
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>

					<!--  Purchase / play panel. Sits beside the content on wide windows, above it otherwise.  -->
					<StackPanel
						x:Name="SidePanel"
						Grid.Row="0"
						Grid.Column="0"
						MaxWidth="560"
						HorizontalAlignment="Left"
						Spacing="16">
						<Border
							Width="240"
							Height="320"
							HorizontalAlignment="Left"
							Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
							CornerRadius="8">
							<Image Source="{x:Bind ViewModel.CoverImageUrl, Mode=OneWay, Converter={StaticResource DecodedImageUrlConverter}, ConverterParameter=240}" Stretch="UniformToFill" />
						</Border>

						<Border
							Padding="8,3"
							HorizontalAlignment="Left"
							Background="{ThemeResource AccentFillColorDefaultBrush}"
							CornerRadius="4"
							Visibility="{x:Bind ViewModel.IsOwned, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
							<TextBlock
								FontWeight="SemiBold"
								Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
								Text="{x:Bind ViewModel.OwnershipText, Mode=OneWay}" />
						</Border>

						<StackPanel
							Orientation="Horizontal"
							Spacing="10"
							Visibility="{x:Bind ViewModel.ShowPrice, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
							<Border
								Padding="8,2"
								VerticalAlignment="Center"
								Background="{ThemeResource AccentFillColorDefaultBrush}"
								CornerRadius="4"
								Visibility="{x:Bind ViewModel.HasDiscount, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
								<TextBlock
									FontWeight="SemiBold"
									Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
									Text="{x:Bind ViewModel.DiscountText, Mode=OneWay}" />
							</Border>
							<TextBlock
								VerticalAlignment="Center"
								Foreground="{ThemeResource TextFillColorSecondaryBrush}"
								Text="{x:Bind ViewModel.OriginalPriceText, Mode=OneWay}"
								TextDecorations="Strikethrough"
								Visibility="{x:Bind ViewModel.HasOriginalPrice, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
							<TextBlock
								VerticalAlignment="Center"
								Style="{StaticResource SubtitleTextBlockStyle}"
								Text="{x:Bind ViewModel.PriceText, Mode=OneWay}" />
						</StackPanel>

						<Button
							MinWidth="240"
							Height="44"
							HorizontalAlignment="Left"
							Command="{x:Bind ViewModel.PrimaryActionCommand}"
							IsEnabled="{x:Bind ViewModel.IsPrimaryActionEnabled, Mode=OneWay}"
							Style="{StaticResource AccentButtonStyle}">
							<StackPanel Orientation="Horizontal" Spacing="12">
								<ProgressRing
									Width="18"
									Height="18"
									Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
									IsActive="True"
									IsIndeterminate="{x:Bind ViewModel.IsProgressIndeterminate, Mode=OneWay}"
									Visibility="{x:Bind ViewModel.IsProgressVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
									Value="{x:Bind ViewModel.ProgressValue, Mode=OneWay}" />
								<FontIcon FontSize="16" Glyph="{x:Bind ViewModel.PrimaryAction, Mode=OneWay, Converter={StaticResource StoreProductActionGlyphConverter}}" />
								<TextBlock
									FontSize="16"
									Style="{StaticResource SubtitleTextBlockStyle}"
									Text="{x:Bind ViewModel.PrimaryActionText, Mode=OneWay}" />
							</StackPanel>
						</Button>

						<StackPanel Spacing="4">
							<HyperlinkButton
								Padding="0,4"
								Command="{x:Bind ViewModel.OpenInLibraryCommand}"
								Visibility="{x:Bind ViewModel.CanOpenInLibrary, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
								<StackPanel Orientation="Horizontal" Spacing="8">
									<FontIcon FontSize="14" Glyph="&#xE8F1;" />
									<TextBlock Text="Manage in library" />
								</StackPanel>
							</HyperlinkButton>
							<HyperlinkButton
								Padding="0,4"
								Command="{x:Bind ViewModel.OpenOnWebCommand}"
								ToolTipService.ToolTip="Reviews, system requirements and add-ons"
								Visibility="{x:Bind ViewModel.CanOpenOnWeb, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
								<StackPanel Orientation="Horizontal" Spacing="8">
									<FontIcon FontSize="14" Glyph="&#xE774;" />
									<TextBlock Text="More on the Epic Games Store" />
								</StackPanel>
							</HyperlinkButton>
						</StackPanel>

						<StackPanel Spacing="10">
							<StackPanel Spacing="2" Visibility="{x:Bind ViewModel.HasDeveloper, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
								<TextBlock
									Foreground="{ThemeResource TextFillColorSecondaryBrush}"
									Style="{StaticResource CaptionTextBlockStyle}"
									Text="Developer" />
								<TextBlock Text="{x:Bind ViewModel.Developer, Mode=OneWay}" TextWrapping="Wrap" />
							</StackPanel>
							<StackPanel Spacing="2" Visibility="{x:Bind ViewModel.HasPublisher, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
								<TextBlock
									Foreground="{ThemeResource TextFillColorSecondaryBrush}"
									Style="{StaticResource CaptionTextBlockStyle}"
									Text="Publisher" />
								<TextBlock Text="{x:Bind ViewModel.Publisher, Mode=OneWay}" TextWrapping="Wrap" />
							</StackPanel>
							<StackPanel Spacing="2" Visibility="{x:Bind ViewModel.HasReleaseDate, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
								<TextBlock
									Foreground="{ThemeResource TextFillColorSecondaryBrush}"
									Style="{StaticResource CaptionTextBlockStyle}"
									Text="Release date" />
								<TextBlock Text="{x:Bind ViewModel.ReleaseDateText, Mode=OneWay}" />
							</StackPanel>
						</StackPanel>
					</StackPanel>

					<StackPanel
						x:Name="MainPanel"
						Grid.Row="1"
						Grid.Column="0"
						MaxWidth="900"
						HorizontalAlignment="Left"
						Spacing="20">
						<TextBlock
							Style="{StaticResource BodyStrongTextBlockStyle}"
							Text="{x:Bind ViewModel.Summary, Mode=OneWay}"
							TextWrapping="Wrap"
							Visibility="{x:Bind ViewModel.HasSummary, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

						<ItemsRepeater ItemsSource="{x:Bind ViewModel.Tags, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasTags, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
							<ItemsRepeater.Layout>
								<StackLayout Orientation="Horizontal" Spacing="8" />
							</ItemsRepeater.Layout>
							<ItemsRepeater.ItemTemplate>
								<DataTemplate x:DataType="x:String">
									<Border
										Padding="10,4"
										Background="{ThemeResource ControlFillColorSecondaryBrush}"
										BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
										BorderThickness="1"
										CornerRadius="12">
										<TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind}" />
									</Border>
								</DataTemplate>
							</ItemsRepeater.ItemTemplate>
						</ItemsRepeater>

						<FlipView
							Height="400"
							Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
							CornerRadius="8"
							ItemsSource="{x:Bind ViewModel.GalleryImageUrls, Mode=OneWay}"
							Visibility="{x:Bind ViewModel.HasGallery, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
							<FlipView.ItemTemplate>
								<DataTemplate x:DataType="x:String">
									<Image Source="{x:Bind Converter={StaticResource DecodedImageUrlConverter}, ConverterParameter=1280}" Stretch="Uniform" />
								</DataTemplate>
							</FlipView.ItemTemplate>
						</FlipView>

						<StackPanel Spacing="8" Visibility="{x:Bind ViewModel.HasDescription, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
							<TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="About" />
							<TextBlock
								IsTextSelectionEnabled="True"
								Style="{StaticResource BodyTextBlockStyle}"
								Text="{x:Bind ViewModel.Description, Mode=OneWay}"
								TextWrapping="Wrap" />
						</StackPanel>
					</StackPanel>
				</Grid>
			</StackPanel>
		</ScrollViewer>

		<StackPanel
			HorizontalAlignment="Center"
			VerticalAlignment="Center"
			Spacing="12"
			Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
			<ProgressRing
				Width="48"
				Height="48"
				HorizontalAlignment="Center"
				IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
			<TextBlock
				HorizontalAlignment="Center"
				Foreground="{ThemeResource TextFillColorSecondaryBrush}"
				Text="{x:Bind ViewModel.Title, Mode=OneWay}" />
		</StackPanel>

		<StackPanel
			MaxWidth="520"
			HorizontalAlignment="Center"
			VerticalAlignment="Center"
			Spacing="12"
			Visibility="{x:Bind ViewModel.ShowError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
			<TextBlock
				HorizontalAlignment="Center"
				Style="{ThemeResource SubtitleTextBlockStyle}"
				Text="{x:Bind ViewModel.Title, Mode=OneWay}"
				TextAlignment="Center"
				TextWrapping="Wrap" />
			<TextBlock
				HorizontalAlignment="Center"
				Foreground="{ThemeResource TextFillColorSecondaryBrush}"
				Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
				TextAlignment="Center"
				TextWrapping="Wrap" />
			<StackPanel
				HorizontalAlignment="Center"
				Orientation="Horizontal"
				Spacing="8">
				<Button Command="{x:Bind ViewModel.RetryCommand}" Content="Try again" />
				<Button
					Command="{x:Bind ViewModel.OpenOnWebCommand}"
					Content="Open on the Epic Games Store"
					Visibility="{x:Bind ViewModel.CanOpenOnWeb, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
			</StackPanel>
		</StackPanel>

		<controls:AppInstallDialog x:Name="InstallDialog" />
	</Grid>
</Page>
