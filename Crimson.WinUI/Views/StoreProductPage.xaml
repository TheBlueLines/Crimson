<Page
	x:Class="Crimson.Views.StoreProductPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="using:Crimson.Controls"
	xmlns:converters="using:CommunityToolkit.WinUI.Converters"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:models="using:Crimson.Models"
	xmlns:utils="using:Crimson.Utils"
	xmlns:viewModels="using:Crimson.ViewModels"
	mc:Ignorable="d">

	<Page.Resources>
		<converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
		<utils:DecodedImageUrlConverter x:Key="DecodedImageUrlConverter" />
		<utils:StoreProductActionGlyphConverter x:Key="StoreProductActionGlyphConverter" />

		<!--  Matches the GameInfoPage hero so store and library pages feel like one app.  -->
		<LinearGradientBrush x:Key="HeroScrimBrush" StartPoint="0,0" EndPoint="0,1">
			<GradientStop Offset="0" Color="#33000000" />
			<GradientStop Offset="0.5" Color="Transparent" />
			<GradientStop Offset="1" Color="#CC000000" />
		</LinearGradientBrush>
	</Page.Resources>

	<Grid x:Name="RootGrid">
		<VisualStateManager.VisualStateGroups>
			<VisualStateGroup>
				<VisualState x:Name="Wide">
					<VisualState.StateTriggers>
						<AdaptiveTrigger MinWindowWidth="1100" />
					</VisualState.StateTriggers>
					<VisualState.Setters>
						<Setter Target="HeroSection.Height" Value="340" />
						<Setter Target="SideColumn.Width" Value="320" />
						<Setter Target="SidePanel.(Grid.Column)" Value="1" />
						<Setter Target="SidePanel.(Grid.Row)" Value="0" />
						<Setter Target="SidePanel.(Grid.RowSpan)" Value="2" />
						<Setter Target="MainPanel.(Grid.Row)" Value="0" />
						<Setter Target="MainPanel.(Grid.RowSpan)" Value="2" />
					</VisualState.Setters>
				</VisualState>
				<VisualState x:Name="Narrow" />
			</VisualStateGroup>
		</VisualStateManager.VisualStateGroups>

		<ScrollViewer
			HorizontalScrollBarVisibility="Disabled"
			VerticalScrollBarVisibility="Auto"
			Visibility="{x:Bind ViewModel.IsContentVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
			<StackPanel>
				<Grid
					x:Name="HeroSection"
					Height="260"
					Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
					<Image Source="{x:Bind ViewModel.HeroImageUrl, Mode=OneWay, Converter={StaticResource DecodedImageUrlConverter}, ConverterParameter=1920}" Stretch="UniformToFill" />
					<Border Background="{StaticResource HeroScrimBrush}" />
					<TextBlock
						MaxWidth="900"
						Margin="36,0,36,24"
						HorizontalAlignment="Left"
						VerticalAlignment="Bottom"
						FontWeight="SemiBold"
						Foreground="White"
						Style="{StaticResource TitleLargeTextBlockStyle}"
						Text="{x:Bind ViewModel.Title, Mode=OneWay}"
						TextTrimming="CharacterEllipsis"
						TextWrapping="Wrap" />
				</Grid>

				<Grid
					Padding="36,24,36,36"
					ColumnSpacing="36"
					RowSpacing="24">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition x:Name="SideColumn" Width="0" />
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>

					<!--  Purchase / play panel. Sits beside the content on wide windows, above it otherwise.  -->
					<StackPanel
						x:Name="SidePanel"
						Grid.Row="0"
						Grid.Column="0"
						MaxWidth="560"
						HorizontalAlignment="Left"
						Spacing="16">
						<Border
							Width="240"
							Height="320"
							HorizontalAlignment="Left"
							Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
							CornerRadius="8">
							<Image Source="{x:Bind ViewModel.CoverImageUrl, Mode=OneWay, Converter={StaticResource DecodedImageUrlConverter}, ConverterParameter=240}" Stretch="UniformToFill" />
						</Border>

						<Border
							Padding="8,3"
							HorizontalAlignment="Left"
							Background="{ThemeResource AccentFillColorDefaultBrush}"
							CornerRadius="4"
							Visibility="{x:Bind ViewModel.IsOwned, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
							<TextBlock
								FontWeight="SemiBold"
								Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
								Text="{x:Bind ViewModel.OwnershipText, Mode=OneWay}" />
						</Border>

						<StackPanel
							Orientation="Horizontal"
							Spacing="10"
							Visibility="{x:Bind ViewModel.ShowPrice, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
							<Border
								Padding="8,2"
								VerticalAlignment="Center"
								Background="{ThemeResource AccentFillColorDefaultBrush}"
								CornerRadius="4"
								Visibility="{x:Bind ViewModel.HasDiscount, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
								<TextBlock
									FontWeight="SemiBold"
									Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
									Text="{x:Bind ViewModel.DiscountText, Mode=OneWay}" />
							</Border>
							<TextBlock
								VerticalAlignment="Center"
								Foreground="{ThemeResource TextFillColorSecondaryBrush}"
								Text="{x:Bind ViewModel.OriginalPriceText, Mode=OneWay}"
								TextDecorations="Strikethrough"
								Visibility="{x:Bind ViewModel.HasOriginalPrice, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
							<TextBlock
								VerticalAlignment="Center"
								Style="{StaticResource SubtitleTextBlockStyle}"
								Text="{x:Bind ViewModel.PriceText, Mode=OneWay}" />
						</StackPanel>

						<Button
							MinWidth="240"
							Height="44"
							HorizontalAlignment="Left"
							Command="{x:Bind ViewModel.PrimaryActionCommand}"
							IsEnabled="{x:Bind ViewModel.IsPrimaryActionEnabled, Mode=OneWay}"
							Style="{StaticResource AccentButtonStyle}">
							<StackPanel Orientation="Horizontal" Spacing="12">
								<ProgressRing
									Width="18"
									Height="18"
									Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
									IsActive="True"
									IsIndeterminate="{x:Bind ViewModel.IsProgressIndeterminate, Mode=OneWay}"
									Visibility="{x:Bind ViewModel.IsProgressVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
									Value="{x:Bind ViewModel.ProgressValue, Mode=OneWay}" />
								<FontIcon FontSize="16" Glyph="{x:Bind ViewModel.PrimaryAction, Mode=OneWay, Converter={StaticResource StoreProductActionGlyphConverter}}" />
								<TextBlock
									FontSize="16"
									Style="{StaticResource SubtitleTextBlockStyle}"
									Text="{x:Bind ViewModel.PrimaryActionText, Mode=OneWay}" />
							</StackPanel>
						</Button>

						<StackPanel Spacing="4">
							<HyperlinkButton
								Padding="0,4"
								Command="{x:Bind ViewModel.OpenInLibraryCommand}"
								Visibility="{x:Bind ViewModel.CanOpenInLibrary, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
								<StackPanel Orientation="Horizontal" Spacing="8">
									<FontIcon FontSize="14" Glyph="&#xE8F1;" />
									<TextBlock Text="Manage in library" />
								</StackPanel>
							</HyperlinkButton>
							<HyperlinkButton
								Padding="0,4"
								Command="{x:Bind ViewModel.OpenOnWebCommand}"
								Visibility="{x:Bind ViewModel.CanOpenOnWeb, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
								<StackPanel Orientation="Horizontal" Spacing="8">
									<FontIcon FontSize="14" Glyph="&#xE774;" />
									<TextBlock Text="More on the Epic Games Store" />
								</StackPanel>
							</HyperlinkButton>
						</StackPanel>

						<StackPanel Spacing="10">
							<StackPanel Spacing="2" Visibility="{x:Bind ViewModel.HasDeveloper, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
								<TextBlock
									Foreground="{ThemeResource TextFillColorSecondaryBrush}"
									Style="{StaticResource CaptionTextBlockStyle}"
									Text="Developer" />
								<TextBlock Text="{x:Bind ViewModel.Developer, Mode=OneWay}" TextWrapping="Wrap" />
							</StackPanel>
							<StackPanel Spacing="2" Visibility="{x:Bind ViewModel.HasPublisher, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
								<TextBlock
									Foreground="{ThemeResource TextFillColorSecondaryBrush}"
									Style="{StaticResource CaptionTextBlockStyle}"
									Text="Publisher" />
								<TextBlock Text="{x:Bind ViewModel.Publisher, Mode=OneWay}" TextWrapping="Wrap" />
							</StackPanel>
							<StackPanel Spacing="2" Visibility="{x:Bind ViewModel.HasReleaseDate, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
								<TextBlock
									Foreground="{ThemeResource TextFillColorSecondaryBrush}"
									Style="{StaticResource CaptionTextBlockStyle}"
									Text="Release date" />
								<TextBlock Text="{x:Bind ViewModel.ReleaseDateText, Mode=OneWay}" />
							</StackPanel>
							<StackPanel Spacing="2" Visibility="{x:Bind ViewModel.HasRefundType, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
								<TextBlock
									Foreground="{ThemeResource TextFillColorSecondaryBrush}"
									Style="{StaticResource CaptionTextBlockStyle}"
									Text="Refund type" />
								<TextBlock Text="{x:Bind ViewModel.RefundTypeText, Mode=OneWay}" />
							</StackPanel>
							<StackPanel Spacing="2" Visibility="{x:Bind ViewModel.HasSocialLinks, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
								<TextBlock
									Foreground="{ThemeResource TextFillColorSecondaryBrush}"
									Style="{StaticResource CaptionTextBlockStyle}"
									Text="Follow" />
								<ItemsRepeater ItemsSource="{x:Bind ViewModel.SocialLinks, Mode=OneWay}">
									<ItemsRepeater.ItemTemplate>
										<DataTemplate x:DataType="models:StoreSocialLink">
											<HyperlinkButton
												Padding="0,2"
												Click="SocialLink_Click"
												Content="{x:Bind Platform}"
												DataContext="{x:Bind}" />
										</DataTemplate>
									</ItemsRepeater.ItemTemplate>
								</ItemsRepeater>
							</StackPanel>
						</StackPanel>
					</StackPanel>

					<StackPanel
						x:Name="MainPanel"
						Grid.Row="1"
						Grid.Column="0"
						MaxWidth="900"
						HorizontalAlignment="Left"
						Spacing="20">
						<TextBlock
							Style="{StaticResource BodyStrongTextBlockStyle}"
							Text="{x:Bind ViewModel.Summary, Mode=OneWay}"
							TextWrapping="Wrap"
							Visibility="{x:Bind ViewModel.HasSummary, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

						<ItemsRepeater ItemsSource="{x:Bind ViewModel.Tags, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasTags, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
							<ItemsRepeater.Layout>
								<StackLayout Orientation="Horizontal" Spacing="8" />
							</ItemsRepeater.Layout>
							<ItemsRepeater.ItemTemplate>
								<DataTemplate x:DataType="x:String">
									<Border
										Padding="10,4"
										Background="{ThemeResource ControlFillColorSecondaryBrush}"
										BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
										BorderThickness="1"
										CornerRadius="12">
										<TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind}" />
									</Border>
								</DataTemplate>
							</ItemsRepeater.ItemTemplate>
						</ItemsRepeater>

						<!--  Screenshots and trailer covers, like the web page's media carousel.  -->
						<StackPanel Spacing="8" Visibility="{x:Bind ViewModel.HasMedia, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
							<FlipView
								x:Name="MediaFlipView"
								Height="460"
								Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
								CornerRadius="8"
								ItemsSource="{x:Bind ViewModel.Media, Mode=OneWay}">
								<FlipView.ItemTemplate>
									<DataTemplate x:DataType="models:StoreMediaItem">
										<Grid>
											<Image Source="{x:Bind ImageUrl, Converter={StaticResource DecodedImageUrlConverter}, ConverterParameter=1280}" Stretch="Uniform" />
											<!--  Trailers can only be played on the web store; the cover shows there is one.  -->
											<Border
												Width="72"
												Height="72"
												HorizontalAlignment="Center"
												VerticalAlignment="Center"
												Background="#99000000"
												CornerRadius="36"
												Visibility="{x:Bind IsVideo, Converter={StaticResource BoolToVisibilityConverter}}">
												<FontIcon
													FontSize="28"
													Foreground="White"
													Glyph="&#xE768;" />
											</Border>
										</Grid>
									</DataTemplate>
								</FlipView.ItemTemplate>
							</FlipView>
							<PipsPager
								HorizontalAlignment="Center"
								MaxVisiblePips="12"
								NumberOfPages="{x:Bind ViewModel.Media.Count, Mode=OneWay}"
								SelectedPageIndex="{x:Bind MediaFlipView.SelectedIndex, Mode=TwoWay}" />
						</StackPanel>

						<!--  The full description with its headings and pictures, in the web page's order.  -->
						<StackPanel Spacing="12" Visibility="{x:Bind ViewModel.HasDescriptionBlocks, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
							<TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="About" />
							<ItemsRepeater ItemsSource="{x:Bind ViewModel.DescriptionBlocks, Mode=OneWay}">
								<ItemsRepeater.Layout>
									<StackLayout Spacing="12" />
								</ItemsRepeater.Layout>
								<ItemsRepeater.ItemTemplate>
									<DataTemplate x:DataType="utils:StoreDescriptionBlock">
										<Grid>
											<TextBlock
												Margin="0,8,0,0"
												Style="{StaticResource BodyStrongTextBlockStyle}"
												FontSize="18"
												Text="{x:Bind Text}"
												TextWrapping="Wrap"
												Visibility="{x:Bind IsHeading, Converter={StaticResource BoolToVisibilityConverter}}" />
											<TextBlock
												IsTextSelectionEnabled="True"
												Style="{StaticResource BodyTextBlockStyle}"
												Text="{x:Bind Text}"
												TextWrapping="Wrap"
												Visibility="{x:Bind IsText, Converter={StaticResource BoolToVisibilityConverter}}" />
											<Border
												HorizontalAlignment="Left"
												CornerRadius="8"
												Visibility="{x:Bind IsImage, Converter={StaticResource BoolToVisibilityConverter}}">
												<Image
													MaxHeight="520"
													Source="{x:Bind ImageUrl, Converter={StaticResource DecodedImageUrlConverter}, ConverterParameter=900}"
													Stretch="Uniform" />
											</Border>
										</Grid>
									</DataTemplate>
								</ItemsRepeater.ItemTemplate>
							</ItemsRepeater>
						</StackPanel>

						<!--  Epic player ratings and the OpenCritic summary.  -->
						<StackPanel Spacing="12" Visibility="{x:Bind ViewModel.HasRatings, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
							<TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Ratings" />
							<Grid ColumnSpacing="12">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>
								<Border
									Padding="20"
									Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
									BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
									BorderThickness="1"
									CornerRadius="8"
									Visibility="{x:Bind ViewModel.HasPlayerRating, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
									<StackPanel Spacing="8">
										<TextBlock
											Foreground="{ThemeResource TextFillColorSecondaryBrush}"
											Style="{StaticResource CaptionTextBlockStyle}"
											Text="Epic player rating" />
										<StackPanel Orientation="Horizontal" Spacing="8">
											<TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{x:Bind ViewModel.PlayerRatingText, Mode=OneWay}" />
											<FontIcon
												VerticalAlignment="Center"
												FontSize="22"
												Foreground="Gold"
												Glyph="&#xE735;" />
											<TextBlock
												VerticalAlignment="Center"
												Foreground="{ThemeResource TextFillColorSecondaryBrush}"
												Text="out of 5" />
										</StackPanel>
										<ItemsRepeater ItemsSource="{x:Bind ViewModel.RatingHighlights, Mode=OneWay}">
											<ItemsRepeater.ItemTemplate>
												<DataTemplate x:DataType="x:String">
													<TextBlock Text="{x:Bind}" TextWrapping="Wrap" />
												</DataTemplate>
											</ItemsRepeater.ItemTemplate>
										</ItemsRepeater>
									</StackPanel>
								</Border>
								<Border
									Grid.Column="1"
									Padding="20"
									Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
									BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
									BorderThickness="1"
									CornerRadius="8"
									Visibility="{x:Bind ViewModel.HasCriticScore, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
									<StackPanel Spacing="8">
										<TextBlock
											Foreground="{ThemeResource TextFillColorSecondaryBrush}"
											Style="{StaticResource CaptionTextBlockStyle}"
											Text="OpenCritic" />
										<StackPanel Orientation="Horizontal" Spacing="16">
											<StackPanel>
												<TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{x:Bind ViewModel.CriticScoreText, Mode=OneWay}" />
												<TextBlock
													Foreground="{ThemeResource TextFillColorSecondaryBrush}"
													Style="{StaticResource CaptionTextBlockStyle}"
													Text="Top critic average" />
											</StackPanel>
											<StackPanel Visibility="{x:Bind ViewModel.HasCriticRecommended, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
												<TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{x:Bind ViewModel.CriticRecommendedText, Mode=OneWay}" />
												<TextBlock
													Foreground="{ThemeResource TextFillColorSecondaryBrush}"
													Style="{StaticResource CaptionTextBlockStyle}"
													Text="Critics recommend" />
											</StackPanel>
										</StackPanel>
										<TextBlock
											Text="{x:Bind ViewModel.CriticAward, Mode=OneWay}"
											Visibility="{x:Bind ViewModel.HasCriticAward, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
									</StackPanel>
								</Border>
							</Grid>
						</StackPanel>

						<!--  Add-ons and extras sold for this game.  -->
						<StackPanel Spacing="12" Visibility="{x:Bind ViewModel.HasAddOns, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
							<TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Add-ons" />
							<ItemsRepeater ItemsSource="{x:Bind ViewModel.AddOns, Mode=OneWay}">
								<ItemsRepeater.Layout>
									<UniformGridLayout
										MinColumnSpacing="12"
										MinItemWidth="160"
										MinRowSpacing="12"
										ItemsStretch="Uniform" />
								</ItemsRepeater.Layout>
								<ItemsRepeater.ItemTemplate>
									<DataTemplate x:DataType="viewModels:StoreItem">
										<Button
											Padding="0"
											HorizontalAlignment="Stretch"
											HorizontalContentAlignment="Stretch"
											Click="AddOn_Click"
											DataContext="{x:Bind}"
											ToolTipService.ToolTip="{x:Bind Title}">
											<StackPanel>
												<Border Height="200" CornerRadius="4,4,0,0">
													<Image Source="{x:Bind ImageUrl, Converter={StaticResource DecodedImageUrlConverter}, ConverterParameter=320}" Stretch="UniformToFill" />
												</Border>
												<StackPanel Padding="10,8" Spacing="2">
													<TextBlock
														MaxLines="2"
														Style="{StaticResource BodyStrongTextBlockStyle}"
														Text="{x:Bind Title}"
														TextTrimming="CharacterEllipsis"
														TextWrapping="Wrap" />
													<TextBlock
														Foreground="{ThemeResource TextFillColorSecondaryBrush}"
														Text="{x:Bind PriceText}" />
												</StackPanel>
											</StackPanel>
										</Button>
									</DataTemplate>
								</ItemsRepeater.ItemTemplate>
							</ItemsRepeater>
						</StackPanel>

						<!--  Windows system requirements, minimum next to recommended.  -->
						<StackPanel Spacing="12" Visibility="{x:Bind ViewModel.HasRequirements, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
							<TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="System requirements" />
							<Border
								Padding="20"
								Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
								BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
								BorderThickness="1"
								CornerRadius="8">
								<StackPanel Spacing="14">
									<Grid ColumnSpacing="24">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="*" />
										</Grid.ColumnDefinitions>
										<TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Minimum" />
										<TextBlock
											Grid.Column="1"
											Style="{StaticResource BodyStrongTextBlockStyle}"
											Text="Recommended" />
									</Grid>
									<ItemsRepeater ItemsSource="{x:Bind ViewModel.Requirements, Mode=OneWay}">
										<ItemsRepeater.Layout>
											<StackLayout Spacing="14" />
										</ItemsRepeater.Layout>
										<ItemsRepeater.ItemTemplate>
											<DataTemplate x:DataType="models:StoreRequirement">
												<Grid ColumnSpacing="24">
													<Grid.ColumnDefinitions>
														<ColumnDefinition Width="*" />
														<ColumnDefinition Width="*" />
													</Grid.ColumnDefinitions>
													<StackPanel Spacing="2">
														<TextBlock
															Foreground="{ThemeResource TextFillColorSecondaryBrush}"
															Style="{StaticResource CaptionTextBlockStyle}"
															Text="{x:Bind Title}" />
														<TextBlock
															IsTextSelectionEnabled="True"
															Text="{x:Bind Minimum}"
															TextWrapping="Wrap" />
													</StackPanel>
													<StackPanel Grid.Column="1" Spacing="2">
														<TextBlock
															Foreground="{ThemeResource TextFillColorSecondaryBrush}"
															Style="{StaticResource CaptionTextBlockStyle}"
															Text="{x:Bind Title}" />
														<TextBlock
															IsTextSelectionEnabled="True"
															Text="{x:Bind Recommended}"
															TextWrapping="Wrap" />
													</StackPanel>
												</Grid>
											</DataTemplate>
										</ItemsRepeater.ItemTemplate>
									</ItemsRepeater>
								</StackPanel>
							</Border>
						</StackPanel>

						<!--  Supported languages.  -->
						<StackPanel Spacing="12" Visibility="{x:Bind ViewModel.HasAudioLanguages, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
							<TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Languages" />
							<StackPanel Spacing="2">
								<TextBlock
									Foreground="{ThemeResource TextFillColorSecondaryBrush}"
									Style="{StaticResource CaptionTextBlockStyle}"
									Text="Audio" />
								<TextBlock Text="{x:Bind ViewModel.AudioLanguagesText, Mode=OneWay}" TextWrapping="Wrap" />
							</StackPanel>
							<StackPanel Spacing="2" Visibility="{x:Bind ViewModel.HasTextLanguages, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
								<TextBlock
									Foreground="{ThemeResource TextFillColorSecondaryBrush}"
									Style="{StaticResource CaptionTextBlockStyle}"
									Text="Text" />
								<TextBlock Text="{x:Bind ViewModel.TextLanguagesText, Mode=OneWay}" TextWrapping="Wrap" />
							</StackPanel>
						</StackPanel>
					</StackPanel>
				</Grid>
			</StackPanel>
		</ScrollViewer>

		<StackPanel
			HorizontalAlignment="Center"
			VerticalAlignment="Center"
			Spacing="12"
			Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
			<ProgressRing
				Width="48"
				Height="48"
				HorizontalAlignment="Center"
				IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
			<TextBlock
				HorizontalAlignment="Center"
				Foreground="{ThemeResource TextFillColorSecondaryBrush}"
				Text="{x:Bind ViewModel.Title, Mode=OneWay}" />
		</StackPanel>

		<StackPanel
			MaxWidth="520"
			HorizontalAlignment="Center"
			VerticalAlignment="Center"
			Spacing="12"
			Visibility="{x:Bind ViewModel.ShowError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
			<TextBlock
				HorizontalAlignment="Center"
				Style="{ThemeResource SubtitleTextBlockStyle}"
				Text="{x:Bind ViewModel.Title, Mode=OneWay}"
				TextAlignment="Center"
				TextWrapping="Wrap" />
			<TextBlock
				HorizontalAlignment="Center"
				Foreground="{ThemeResource TextFillColorSecondaryBrush}"
				Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
				TextAlignment="Center"
				TextWrapping="Wrap" />
			<StackPanel
				HorizontalAlignment="Center"
				Orientation="Horizontal"
				Spacing="8">
				<Button Command="{x:Bind ViewModel.RetryCommand}" Content="Try again" />
				<Button
					Command="{x:Bind ViewModel.OpenOnWebCommand}"
					Content="Open on the Epic Games Store"
					Visibility="{x:Bind ViewModel.CanOpenOnWeb, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
			</StackPanel>
		</StackPanel>

		<controls:AppInstallDialog x:Name="InstallDialog" />
	</Grid>
</Page>
