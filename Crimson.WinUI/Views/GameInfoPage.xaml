<Page
	x:Class="Crimson.Views.GameInfoPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="using:Crimson.Controls"
	xmlns:converters="using:CommunityToolkit.WinUI.Converters"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="using:Crimson"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:utils="using:Crimson.Utils"
	mc:Ignorable="d">

	<Page.Resources>
		<converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
		<utils:GamePrimaryActionGlyphConverter x:Key="GamePrimaryActionGlyphConverter" />
	</Page.Resources>

	<!--  The shell paints the selected game's artwork behind this transparent page.  -->
	<Grid Background="Transparent">
		<Grid Padding="36">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
			</Grid.RowDefinitions>

			<InfoBar
				Grid.Row="0"
				HorizontalAlignment="Left"
				IsClosable="True"
				IsOpen="{x:Bind ViewModel.IsInstallErrorVisible, Mode=TwoWay}"
				Message="{x:Bind ViewModel.InstallErrorMessage, Mode=OneWay}"
				Severity="Error"
				Title="Installation failed" />

			<StackPanel
				Grid.Row="1"
				HorizontalAlignment="Right"
				VerticalAlignment="Bottom"
				Spacing="16">
				<TextBlock
					MaxWidth="760"
					HorizontalAlignment="Right"
					FontWeight="SemiBold"
					Foreground="White"
					Style="{StaticResource TitleLargeTextBlockStyle}"
					Text="{x:Bind ViewModel.Game.AppTitle, Mode=OneWay}"
					TextAlignment="Right"
					TextTrimming="CharacterEllipsis"
					TextWrapping="Wrap" />

				<StackPanel
					HorizontalAlignment="Right"
					Orientation="Horizontal"
					Spacing="12">
					<Button
						Height="44"
						Command="{x:Bind ViewModel.ImportGameCommand}"
						Visibility="{x:Bind ViewModel.IsImportVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
						<StackPanel Orientation="Horizontal" Spacing="10">
							<FontIcon FontSize="16" Glyph="&#xE8B5;" />
							<TextBlock Style="{StaticResource BodyStrongTextBlockStyle}">Import</TextBlock>
						</StackPanel>
					</Button>

					<DropDownButton
						Height="44"
						IsEnabled="{x:Bind ViewModel.IsInstalled, Mode=OneWay}"
						Visibility="{x:Bind ViewModel.IsInstalled, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
						<StackPanel Orientation="Horizontal" Spacing="10">
							<FontIcon FontSize="16" Glyph="&#xE713;" />
							<TextBlock Style="{StaticResource BodyStrongTextBlockStyle}">Manage</TextBlock>
						</StackPanel>
						<DropDownButton.Flyout>
							<MenuFlyout Placement="Top">
								<MenuFlyout.MenuFlyoutPresenterStyle>
									<Style TargetType="MenuFlyoutPresenter">
										<Setter Property="MinWidth" Value="170" />
									</Style>
								</MenuFlyout.MenuFlyoutPresenterStyle>
								<MenuFlyout.Items>
									<MenuFlyoutItem
										Command="{x:Bind ViewModel.ManageContentCommand}"
										IsEnabled="{x:Bind ViewModel.CanManageContent, Mode=OneWay}"
										Text="Manage content">
										<MenuFlyoutItem.Icon>
											<FontIcon Glyph="&#xE7B8;" />
										</MenuFlyoutItem.Icon>
									</MenuFlyoutItem>
									<MenuFlyoutItem Command="{x:Bind ViewModel.VerifyRepairCommand}" Text="Verify / Repair">
										<MenuFlyoutItem.Icon>
											<FontIcon Glyph="&#xE90F;" />
										</MenuFlyoutItem.Icon>
									</MenuFlyoutItem>
									<MenuFlyoutItem Command="{x:Bind ViewModel.MoveGameCommand}" Text="Move">
										<MenuFlyoutItem.Icon>
											<FontIcon Glyph="&#xE8DE;" />
										</MenuFlyoutItem.Icon>
									</MenuFlyoutItem>
									<MenuFlyoutItem Command="{x:Bind ViewModel.UninstallCommand}" Text="Uninstall">
										<MenuFlyoutItem.Icon>
											<FontIcon Glyph="&#xE74D;" />
										</MenuFlyoutItem.Icon>
									</MenuFlyoutItem>
								</MenuFlyout.Items>
							</MenuFlyout>
						</DropDownButton.Flyout>
					</DropDownButton>

					<Button
						MinWidth="160"
						Height="44"
						Command="{x:Bind ViewModel.PrimaryActionCommand}"
						IsEnabled="{x:Bind ViewModel.IsPrimaryActionEnabled, Mode=OneWay}"
						Style="{StaticResource AccentButtonStyle}">
						<StackPanel Orientation="Horizontal" Spacing="12">
							<ProgressRing
								Width="18"
								Height="18"
								Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
								IsActive="True"
								IsIndeterminate="{x:Bind ViewModel.IsProgressRingIndeterminate, Mode=OneWay}"
								Visibility="{x:Bind ViewModel.IsProgressRingVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
								Value="{x:Bind ViewModel.ProgressValue, Mode=OneWay}" />
							<FontIcon FontSize="16" Glyph="{x:Bind ViewModel.PrimaryAction, Mode=OneWay, Converter={StaticResource GamePrimaryActionGlyphConverter}}" />
							<TextBlock
								FontSize="16"
								Style="{StaticResource SubtitleTextBlockStyle}"
								Text="{x:Bind ViewModel.PrimaryActionButtonText, Mode=OneWay}" />
						</StackPanel>
					</Button>
				</StackPanel>
			</StackPanel>
		</Grid>

		<controls:AppInstallDialog x:Name="InstallDialog" />
	</Grid>
</Page>
