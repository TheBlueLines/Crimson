<Page
	x:Class="Crimson.Views.GameInfoPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="using:Crimson.Controls"
	xmlns:converters="using:CommunityToolkit.WinUI.Converters"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="using:Crimson"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:utils="using:Crimson.Utils"
	mc:Ignorable="d">

	<Page.Resources>
		<converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
		<utils:GamePrimaryActionGlyphConverter x:Key="GamePrimaryActionGlyphConverter" />
		<utils:ImageUrlConverter x:Key="ImageUrlConverter" />

		<!--  Fades the bottom of the hero banner into the page so the title stays readable.  -->
		<LinearGradientBrush x:Key="HeroScrimBrush" StartPoint="0,0" EndPoint="0,1">
			<GradientStop Offset="0" Color="#33000000" />
			<GradientStop Offset="0.5" Color="Transparent" />
			<GradientStop Offset="1" Color="#CC000000" />
		</LinearGradientBrush>
	</Page.Resources>

	<Grid>
		<ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
			<StackPanel>
				<Grid
					x:Name="HeroSection"
					Height="240"
					Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
					<Image
						Source="{x:Bind ViewModel.TitleImageUrl, Converter={StaticResource ImageUrlConverter}, Mode=OneWay}"
						Stretch="UniformToFill" />
					<Border Background="{StaticResource HeroScrimBrush}" />

					<TextBlock
						MaxWidth="900"
						Margin="36,0,36,24"
						HorizontalAlignment="Left"
						VerticalAlignment="Bottom"
						FontWeight="SemiBold"
						Foreground="White"
						Style="{StaticResource TitleLargeTextBlockStyle}"
						Text="{x:Bind ViewModel.Game.AppTitle, Mode=OneWay}"
						TextTrimming="CharacterEllipsis"
						TextWrapping="Wrap" />

					<VisualStateManager.VisualStateGroups>
						<VisualStateGroup>
							<VisualState x:Name="WideHero">
								<VisualState.StateTriggers>
									<AdaptiveTrigger MinWindowWidth="1200" />
								</VisualState.StateTriggers>
								<VisualState.Setters>
									<Setter Target="HeroSection.Height" Value="340" />
								</VisualState.Setters>
							</VisualState>
							<VisualState x:Name="MediumHero">
								<VisualState.StateTriggers>
									<AdaptiveTrigger MinWindowWidth="840" />
								</VisualState.StateTriggers>
								<VisualState.Setters>
									<Setter Target="HeroSection.Height" Value="280" />
								</VisualState.Setters>
							</VisualState>
							<VisualState x:Name="NarrowHero" />
						</VisualStateGroup>
					</VisualStateManager.VisualStateGroups>
				</Grid>

				<StackPanel Padding="36,24,36,36" Spacing="12">
					<InfoBar
						IsClosable="True"
						IsOpen="{x:Bind ViewModel.IsInstallErrorVisible, Mode=TwoWay}"
						Message="{x:Bind ViewModel.InstallErrorMessage, Mode=OneWay}"
						Severity="Error"
						Title="Installation failed" />
					<StackPanel
						HorizontalAlignment="Left"
						Orientation="Horizontal"
						Spacing="12">
						<Button
							MinWidth="160"
							Height="44"
							Command="{x:Bind ViewModel.PrimaryActionCommand}"
							IsEnabled="{x:Bind ViewModel.IsPrimaryActionEnabled, Mode=OneWay}"
							Style="{StaticResource AccentButtonStyle}">
							<StackPanel Orientation="Horizontal" Spacing="12">
								<ProgressRing
									Width="18"
									Height="18"
									Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
									IsActive="True"
									IsIndeterminate="{x:Bind ViewModel.IsProgressRingIndeterminate, Mode=OneWay}"
									Visibility="{x:Bind ViewModel.IsProgressRingVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
									Value="{x:Bind ViewModel.ProgressValue, Mode=OneWay}" />
								<FontIcon FontSize="16" Glyph="{x:Bind ViewModel.PrimaryAction, Mode=OneWay, Converter={StaticResource GamePrimaryActionGlyphConverter}}" />
								<TextBlock
									FontSize="16"
									Style="{StaticResource SubtitleTextBlockStyle}"
									Text="{x:Bind ViewModel.PrimaryActionButtonText, Mode=OneWay}" />
							</StackPanel>
						</Button>

						<Button
							Height="44"
							Command="{x:Bind ViewModel.ImportGameCommand}"
							Visibility="{x:Bind ViewModel.IsImportVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
							<StackPanel Orientation="Horizontal" Spacing="10">
								<FontIcon FontSize="16" Glyph="&#xE8B5;" />
								<TextBlock Style="{StaticResource BodyStrongTextBlockStyle}">Import</TextBlock>
							</StackPanel>
						</Button>

						<DropDownButton
							Height="44"
							IsEnabled="{x:Bind ViewModel.IsInstalled, Mode=OneWay}"
							Visibility="{x:Bind ViewModel.IsInstalled, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
							<StackPanel Orientation="Horizontal" Spacing="10">
								<FontIcon FontSize="16" Glyph="&#xE713;" />
								<TextBlock Style="{StaticResource BodyStrongTextBlockStyle}">Manage</TextBlock>
							</StackPanel>
							<DropDownButton.Flyout>
								<MenuFlyout Placement="Bottom">
									<MenuFlyout.MenuFlyoutPresenterStyle>
										<Style TargetType="MenuFlyoutPresenter">
											<Setter Property="MinWidth" Value="170" />
										</Style>
									</MenuFlyout.MenuFlyoutPresenterStyle>
									<MenuFlyout.Items>
										<MenuFlyoutItem Command="{x:Bind ViewModel.ManageContentCommand}" Text="Manage content"
											IsEnabled="{x:Bind ViewModel.CanManageContent, Mode=OneWay}" />
										<MenuFlyoutItem Command="{x:Bind ViewModel.VerifyRepairCommand}" Text="Verify / Repair">
											<MenuFlyoutItem.Icon>
												<FontIcon Glyph="&#xE90F;" />
											</MenuFlyoutItem.Icon>
										</MenuFlyoutItem>
										<MenuFlyoutItem Command="{x:Bind ViewModel.MoveGameCommand}" Text="Move">
											<MenuFlyoutItem.Icon>
												<FontIcon Glyph="&#xE8DE;" />
											</MenuFlyoutItem.Icon>
										</MenuFlyoutItem>
										<MenuFlyoutItem Command="{x:Bind ViewModel.UninstallCommand}" Text="Uninstall">
											<MenuFlyoutItem.Icon>
												<FontIcon Glyph="&#xE74D;" />
											</MenuFlyoutItem.Icon>
										</MenuFlyoutItem>
									</MenuFlyout.Items>
								</MenuFlyout>
						</DropDownButton.Flyout>
					</DropDownButton>
					</StackPanel>
				</StackPanel>
			</StackPanel>
		</ScrollViewer>

		<controls:AppInstallDialog x:Name="InstallDialog" />
	</Grid>
</Page>
