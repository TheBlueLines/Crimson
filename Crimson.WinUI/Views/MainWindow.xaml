<Window
	x:Class="Crimson.Views.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:crimson="using:Crimson.Views"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="using:Crimson.Views"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d">


	<Grid x:Name="RootGrid">
		<Grid.RowDefinitions>
			<!--  Matches the tall (48px) caption buttons set in MainWindow.StyleCaptionButtons.  -->
			<RowDefinition Height="48" />
			<RowDefinition />
		</Grid.RowDefinitions>

		<!--
			The selected game's key art fills the whole window, title bar and navigation pane
			included. The pane sees it through a blur (PaneBlur) whose width follows the pane
			(MainWindow.UpdatePaneBlurWidth).
		-->
		<Grid
			x:Name="GameBackgroundLayer"
			Grid.RowSpan="2"
			IsHitTestVisible="False"
			Visibility="Collapsed">
			<Grid.Resources>
				<LinearGradientBrush x:Key="GameBackgroundVerticalScrimBrush" StartPoint="0,0" EndPoint="0,1">
					<GradientStop Offset="0" Color="#99000000" />
					<GradientStop Offset="0.2" Color="#1A000000" />
					<GradientStop Offset="0.7" Color="#33000000" />
					<GradientStop Offset="1" Color="#CC000000" />
				</LinearGradientBrush>
				<LinearGradientBrush x:Key="GameBackgroundLeftScrimBrush" StartPoint="0,0" EndPoint="1,0">
					<GradientStop Offset="0" Color="#B3000000" />
					<GradientStop Offset="0.22" Color="#73000000" />
					<GradientStop Offset="0.55" Color="#26000000" />
					<GradientStop Offset="1" Color="#00000000" />
				</LinearGradientBrush>
			</Grid.Resources>
			<!--  Centred so a portrait fallback still zooms into the artwork's main subject.  -->
			<Rectangle>
				<Rectangle.Fill>
					<ImageBrush
						x:Name="GameBackgroundBrush"
						AlignmentX="Center"
						AlignmentY="Center"
						Stretch="UniformToFill" />
				</Rectangle.Fill>
			</Rectangle>
			<Border Background="{StaticResource GameBackgroundVerticalScrimBrush}" />
			<Border Background="{StaticResource GameBackgroundLeftScrimBrush}" />
			<!--  Sits exactly under GlobalSearchBox (48px row, 34px box) so the search pill is frosted too.  -->
			<Border
				x:Name="SearchBlur"
				Width="520"
				Height="34"
				Margin="0,7,0,0"
				HorizontalAlignment="Center"
				VerticalAlignment="Top"
				CornerRadius="8">
				<Border.Background>
					<AcrylicBrush
						FallbackColor="#CC1E1E1E"
						TintColor="#808080"
						TintLuminosityOpacity="0.15"
						TintOpacity="0.1" />
				</Border.Background>
			</Border>
			<!--  In-app acrylic blurs the key art behind it, so the pane takes its colours from the game.  -->
			<Border
				x:Name="PaneBlur"
				Width="0"
				HorizontalAlignment="Left">
				<Border.Background>
					<AcrylicBrush
						FallbackColor="#E6202020"
						TintColor="#000000"
						TintLuminosityOpacity="0.25"
						TintOpacity="0.2" />
				</Border.Background>
			</Border>
		</Grid>

		<!--
			Signing in fills the whole window, title bar included, like a game's key art does.
			Declared before AppTitleBar so the app icon and name stay on top; the search box is
			hidden until signed in (MainWindow.UpdateUIBasedOnAuthenticationStatus).
		-->
		<Grid
			x:Name="LoginModal"
			Grid.RowSpan="2"
			HorizontalAlignment="Stretch"
			VerticalAlignment="Stretch"
			Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
			<Border
				Padding="40"
				HorizontalAlignment="Center"
				VerticalAlignment="Center"
				Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
				<StackPanel Orientation="Vertical" Spacing="20">
					<StackPanel
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						Orientation="Horizontal"
						Spacing="20">
						<ProgressRing IsActive="True" />
						<TextBlock
							x:Name="LoginModalTitle"
							Foreground="{ThemeResource TextFillColorPrimaryBrush}"
							Style="{ThemeResource TitleTextBlockStyle}"
							Text="Loading...." />
					</StackPanel>
					<TextBlock
						x:Name="LoginModalDescription"
						HorizontalAlignment="Center"
						Style="{ThemeResource SubtitleTextBlockStyle}"
						Text="Please wait" />
				</StackPanel>
			</Border>
		</Grid>
		<local:LoginPage
			x:Name="LoginPage"
			Grid.RowSpan="2"
			Visibility="Collapsed" />

		<Grid
			x:Name="AppTitleBar"
			Grid.Row="0"
			Background="Transparent" />
		<AutoSuggestBox
			x:Name="GlobalSearchBox"
			Grid.Row="0"
			Visibility="Collapsed"
			Width="520"
			Height="34"
			HorizontalAlignment="Center"
			VerticalAlignment="Center"
			Canvas.ZIndex="1"
			PlaceholderText="Search for something..."
			QuerySubmitted="GlobalSearchBox_QuerySubmitted"
			TextChanged="GlobalSearchBox_TextChanged"
			TextMemberPath="DisplayText">
			<AutoSuggestBox.Resources>
				<SolidColorBrush x:Key="AutoSuggestBoxSuggestionsListBackground" Color="Transparent" />
				<CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
				<x:Double x:Key="TextControlThemeMinHeight">34</x:Double>
				<x:Double x:Key="TextControlThemeMinWidth">0</x:Double>
			</AutoSuggestBox.Resources>
			<AutoSuggestBox.QueryIcon>
				<SymbolIcon Symbol="Find" />
			</AutoSuggestBox.QueryIcon>
			<AutoSuggestBox.ItemTemplate>
				<DataTemplate>
					<Grid MinHeight="52">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="40" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<Border
								Width="32"
								Height="42"
								HorizontalAlignment="Center"
								VerticalAlignment="Center"
								Background="{ThemeResource ControlFillColorDefaultBrush}"
								CornerRadius="4">
								<Grid>
									<Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
									<FontIcon FontSize="18" Glyph="{Binding IconGlyph}" />
								</Grid>
							</Border>
							<StackPanel
								Grid.Column="1"
								Margin="12,0,0,0"
								VerticalAlignment="Center"
								Spacing="2">
								<TextBlock
									Text="{Binding DisplayText}"
									TextTrimming="CharacterEllipsis" />
								<TextBlock
									FontSize="12"
									Foreground="{ThemeResource TextFillColorSecondaryBrush}"
									Text="{Binding Subtitle}"
									TextTrimming="CharacterEllipsis" />
							</StackPanel>
						</Grid>
						<Grid Visibility="{Binding SkeletonVisibility}">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="40" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<Border
								Width="32"
								Height="42"
								Background="{ThemeResource ControlFillColorSecondaryBrush}"
								CornerRadius="4">
								<ProgressRing
									Width="18"
									Height="18"
									IsActive="True" />
							</Border>
							<StackPanel
								Grid.Column="1"
								Margin="12,0,0,0"
								VerticalAlignment="Center"
								Spacing="7">
								<Border
									Width="180"
									Height="12"
									HorizontalAlignment="Left"
									Background="{ThemeResource ControlFillColorSecondaryBrush}"
									CornerRadius="6" />
								<Border
									Width="110"
									Height="9"
									HorizontalAlignment="Left"
									Background="{ThemeResource ControlFillColorSecondaryBrush}"
									CornerRadius="5" />
							</StackPanel>
						</Grid>
					</Grid>
				</DataTemplate>
			</AutoSuggestBox.ItemTemplate>
		</AutoSuggestBox>

		<!--
			Spans the title bar so the back button sits in it; ContentFrame stays below the title bar.
			The 1px offsets line the buttons up with Fluent Launcher's.
		-->
		<Grid Grid.RowSpan="2" Margin="0,-1,0,0">
			<NavigationView
				x:Name="NavControl"
				BackRequested="NavControl_BackRequested"
				Background="Transparent"
				IsBackEnabled="True"
				IsPaneOpen="False"
				ItemInvoked="NavControl_ItemInvoked"
				OpenPaneLength="300">
				<NavigationView.Resources>
					<Thickness x:Key="NavigationViewPaneContentGridMargin">-1,2,-1,3</Thickness>
					<SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
					<SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
					<Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
					<CornerRadius x:Key="NavigationViewContentGridCornerRadius">0</CornerRadius>
				</NavigationView.Resources>
				<NavigationView.MenuItems>
					<NavigationViewItem
						x:Name="LibraryNavItem"
						Content="Library"
						Icon="Library"
						Tag="Crimson.Views.LibraryPage" />
					<NavigationViewItem
						x:Name="StoreNavItem"
						Content="Store"
						Icon="Shop"
						Tag="Crimson.Views.StorePage" />
					<!--  Installed games are appended here by MainWindow.RebuildInstalledMenu.  -->
				</NavigationView.MenuItems>

				<!--  Pages manage their own scrolling so full-bleed pages can fill the window.  -->
				<!--
					Pages sit on a raised, rounded layer above the pane and title bar. It is a separate
					element so a game page can hide it (key art runs behind the page) while the layer
					keeps following the theme; ContentClip rounds the page itself, inside the stroke.
				-->
				<Grid x:Name="ContentHost" Margin="0,49,0,0">
					<Grid.Resources>
						<ResourceDictionary>
							<ResourceDictionary.ThemeDictionaries>
								<!--  The stock layer fill barely lifts off desktop acrylic, which is brighter than Mica.  -->
								<ResourceDictionary x:Key="Dark">
									<SolidColorBrush x:Key="ContentSurfaceBrush" Color="#12FFFFFF" />
								</ResourceDictionary>
								<ResourceDictionary x:Key="Light">
									<SolidColorBrush x:Key="ContentSurfaceBrush" Color="#80FFFFFF" />
								</ResourceDictionary>
							</ResourceDictionary.ThemeDictionaries>
						</ResourceDictionary>
					</Grid.Resources>
					<Border
						x:Name="ContentSurface"
						Background="{ThemeResource ContentSurfaceBrush}"
						BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
						BorderThickness="1,1,0,0"
						CornerRadius="8,0,0,0" />
					<Border Margin="1,1,0,0" CornerRadius="7,0,0,0">
						<Frame
							x:Name="ContentFrame"
							Background="Transparent"
							HorizontalContentAlignment="Stretch"
							IsTabStop="True"
							VerticalContentAlignment="Stretch" />
					</Border>
				</Grid>

				<NavigationView.FooterMenuItems>
					<!--
						NavigationViewItem hides its Content in the ClosedCompact state, so without
						an Icon this item rendered blank once the pane collapsed.
					-->
					<NavigationViewItem
						x:Name="DownloadsNavItem"
						Content="Downloads"
						Tag="Crimson.Views.DownloadsPage"
						ToolTipService.ToolTip="No downloads in queue">
						<NavigationViewItem.Icon>
							<FontIcon Glyph="&#xE896;" />
						</NavigationViewItem.Icon>
						<NavigationViewItem.InfoBadge>
							<InfoBadge x:Name="DownloadInfoBadge" Visibility="Collapsed" />
						</NavigationViewItem.InfoBadge>
					</NavigationViewItem>
					<!--
						While a download is active and the pane is open, this item stands in for
						DownloadsNavItem (see MainWindow.UpdateDownloadsNavItems).
					-->
					<NavigationViewItem
						x:Name="CurrentDownloadNavItem"
						IsTabStop="False"
						SelectsOnInvoked="False">
						<NavigationViewItem.Icon>
							<FontIcon Glyph="&#xE896;" Visibility="Collapsed" />
						</NavigationViewItem.Icon>
						<crimson:CurrentDownloadControl x:Name="CurrentDownload" />
					</NavigationViewItem>
				</NavigationView.FooterMenuItems>
			</NavigationView>

		</Grid>
		<!--  Above the navigation pane, which reaches into the title bar.  -->
		<Grid
			x:Name="AppTitleContent"
			Grid.Row="0"
			Margin="48,-4,0,0"
			HorizontalAlignment="Left"
			Canvas.ZIndex="1"
			IsHitTestVisible="False">
			<Image
				Width="16"
				Height="16"
				HorizontalAlignment="Left"
				Source="/Images/WindowIcon.png" />
			<TextBlock
				x:Name="AppTitleTextBlock"
				Margin="28,0,0,0"
				VerticalAlignment="Center"
				Style="{StaticResource CaptionTextBlockStyle}"
				Text="Crimson"
				TextWrapping="NoWrap" />
		</Grid>
		<!--
			The search results popup is its own window and Windows draws no backdrop behind it, so
			this in-app acrylic sits under it and blurs the page instead, like SearchBlur does for
			the search box. MainWindow.UpdateSearchResultsBlur sizes it to the open results.
		-->
		<Border
			x:Name="SearchResultsBlur"
			Grid.RowSpan="2"
			HorizontalAlignment="Left"
			VerticalAlignment="Top"
			CornerRadius="8"
			IsHitTestVisible="False"
			Visibility="Collapsed">
			<Border.Background>
				<AcrylicBrush
					FallbackColor="#F0202020"
					TintColor="#1C1C1C"
					TintLuminosityOpacity="0.55"
					TintOpacity="0.35" />
			</Border.Background>
		</Border>
		<crimson:TrayIconView x:Name="TrayIconView" />
	</Grid>
</Window>